{
  "manifest_version": 3,
  "name": "Mona",
  "version": "1.0",
  "description": "High-velocity screen recording studio",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}